{
  "rules": {
    "debug": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "config": {
      ".read": "auth != null"
    },
    "quizzes": {
      ".read": "auth != null"
    },
    "questions": {
      ".read": "auth != null"
    },
    "sessions": {
      "$code": {
        ".read": "auth != null && data.child('hostUid').val() == auth.uid",
        ".write": "auth != null && (data.exists() ? (data.child('hostUid').val() == auth.uid || (!newData.exists() && data.child('hostLeftAt').isNumber() && now > data.child('hostLeftAt').val() + 300000)) : newData.child('hostUid').val() == auth.uid)",
        ".validate": "$code.matches(/^[A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9][A-HJ-NP-Z2-9]$/) && newData.hasChildren(['hostUid', 'quizId', 'status'])",

        "hostUid": {
          ".read": "auth != null",
          ".validate": "newData.val() == auth.uid"
        },
        "quizId": {
          ".read": "auth != null",
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 64"
        },
        "hostLeftAt": {
          ".read": "auth != null",
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "questionCount": {
          ".read": "auth != null",
          ".validate": "newData.parent().child('status').val() == 'starting' && newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 1 && newData.val() <= 50"
        },
        "status": {
          ".read": "auth != null",
          ".validate": "newData.isString() && newData.val().matches(/^(lobby|starting|question|vote|reveal|validation|scores|paused|ended)$/)"
        },
        "settings": {
          ".read": "auth != null",
          ".validate": "newData.hasChildren(['answerMode', 'speedBonus', 'control', 'teams'])",
          "answerMode": { ".validate": "newData.isString() && newData.val().matches(/^(free|choice|bluff)$/)" },
          "speedBonus": { ".validate": "newData.isBoolean()" },
          "control": { ".validate": "newData.isBoolean()" },
          "teams": { ".validate": "newData.isBoolean()" },
          "stepByStep": { ".validate": "newData.isBoolean()" },
          "suspense": { ".validate": "newData.isBoolean()" },
          "teamMode": { ".validate": "newData.isString() && newData.val().matches(/^(random|host|players)$/)" },
          "teamCount": { ".validate": "newData.isNumber() && (newData.val() == 2 || newData.val() == 3 || newData.val() == 4)" },
          "$other": { ".validate": false }
        },
        "currentIndex": {
          ".read": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "phaseStartedAt": {
          ".read": "auth != null",
          ".validate": "newData.isNumber()"
        },
        "phaseEndsAt": {
          ".read": "auth != null",
          ".validate": "newData.isNumber()"
        },
        "pausedFrom": {
          ".read": "auth != null",
          ".validate": "newData.isString() && newData.val().matches(/^(lobby|starting|question|vote|reveal|validation|scores)$/)"
        },
        "remainingMs": {
          ".read": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "currentQuestion": {
          ".read": "auth != null",
          ".validate": "newData.hasChildren(['text', 'difficulty', 'timeLimit'])",
          "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 140" },
          "options": {
            ".validate": "newData.hasChildren(['0', '1', '2', '3'])",
            "$option": { ".validate": "$option.matches(/^[0-3]$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" }
          },
          "difficulty": { ".validate": "newData.val() == 1 || newData.val() == 2 || newData.val() == 3" },
          "timeLimit": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 300" },
          "ask": { ".validate": "newData.isString() && newData.val().matches(/^(title|artist|both)$/)" },
          "choices": {
            ".validate": "newData.hasChildren(['0', '1'])",
            "$choice": { ".validate": "$choice.matches(/^[0-9]{1,2}$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" }
          },
          "audio": {
            ".validate": "newData.hasChildren(['url', 'startS', 'durationS']) && newData.child('startS').val() + newData.child('durationS').val() <= 30",
            "url": { ".validate": "newData.isString() && newData.val().beginsWith('https://') && newData.val().length <= 2048" },
            "startS": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "durationS": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= newData.parent().parent().child('timeLimit').val()" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },
        "reveal": {
          ".read": "auth != null",
          ".validate": "newData.hasChildren(['correctAnswer'])",
          "correctAnswer": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 140" },
          "explanation": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "music": {
            ".validate": "newData.hasChildren(['title', 'artist', 'source'])",
            "title": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 140" },
            "artist": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 140" },
            "source": { ".validate": "newData.isString() && newData.val().matches(/^deezer$/)" },
            "$other": { ".validate": false }
          },
          "stats": {
            "choiceCounts": {
              "$choice": { ".validate": "$choice.matches(/^[0-3]$/) && newData.isNumber() && newData.val() >= 0" }
            },
            "freeAnswers": {
              "$group": {
                ".validate": "$group.matches(/^[0-7]$/) && newData.hasChildren(['value', 'playerIds', 'verdict'])",
                "value": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 123" },
                "playerIds": {
                  "$i": { ".validate": "$i.matches(/^1?[0-9]$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 128" }
                },
                "verdict": { ".validate": "newData.isString() && newData.val().matches(/^(correct|partial|wrong)$/)" },
                "$other": { ".validate": false }
              }
            },
            "bluffChoices": {
              "$choice": {
                ".validate": "$choice.matches(/^[0-9]{1,2}$/) && newData.hasChildren(['text', 'kind'])",
                "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
                "kind": { ".validate": "newData.isString() && newData.val().matches(/^(truth|bluff|decoy)$/)" },
                "authors": { "$i": { ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 128" } },
                "voters": { "$i": { ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 128" } },
                "$other": { ".validate": false }
              }
            },
            "$other": { ".validate": false }
          },
          "results": {
            "$uid": {
              ".validate": "newData.hasChildren(['correct', 'points'])",
              "correct": { ".validate": "newData.isBoolean()" },
              "points": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "partial": { ".validate": "newData.val() == true" },
              "parts": {
                ".validate": "newData.hasChildren(['title', 'artist'])",
                "title": { ".validate": "newData.isBoolean()" },
                "artist": { ".validate": "newData.isBoolean()" },
                "$other": { ".validate": false }
              },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".validate": "newData.hasChildren(['name', 'avatar'])",
            "name": {
              ".write": "auth != null && auth.uid == $uid && root.child('sessions/' + $code + '/status').val() == 'lobby'",
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 12 && newData.val().matches(/^[^ ](.*[^ ])?$/)"
            },
            "avatar": {
              ".write": "auth != null && auth.uid == $uid && root.child('sessions/' + $code + '/status').val() == 'lobby'",
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "connected": {
              ".write": "auth != null && auth.uid == $uid && newData.parent().child('name').exists()",
              ".validate": "newData.isBoolean()"
            },
            "score": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "rank": { ".validate": "newData.isNumber() && newData.val() >= 1" },
            "team": {
              ".write": "auth != null && auth.uid == $uid && data.parent().child('name').exists() && root.child('sessions/' + $code + '/status').val() == 'lobby' && root.child('sessions/' + $code + '/settings/teams').val() == true && root.child('sessions/' + $code + '/settings/teamMode').val() == 'players'",
              ".validate": "newData.isString() && newData.val().matches(/^(pink|cyan|gold|green)$/) && (newData.parent().parent().parent().child('status').val() == 'lobby' || newData.val() == data.val()) && (newData.val() != 'gold' || newData.parent().parent().parent().child('settings/teamCount').val() >= 3) && (newData.val() != 'green' || newData.parent().parent().parent().child('settings/teamCount').val() == 4)"
            },
            "$other": { ".validate": false }
          }
        },
        "teams": {
          ".read": "auth != null",
          "$team": {
            ".validate": "$team.matches(/^(pink|cyan|gold|green)$/) && newData.hasChildren(['score', 'rank'])",
            "score": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "rank": { ".validate": "newData.isNumber() && newData.val() >= 1" },
            "$other": { ".validate": false }
          }
        },
        "teamPoints": {
          ".read": "auth != null",
          "$index": {
            "$team": { ".validate": "$team.matches(/^(pink|cyan|gold|green)$/) && newData.isNumber() && newData.val() >= 0" }
          }
        },
        "teamPresence": {
          ".read": "auth != null",
          "$index": {
            "$uid": { ".validate": "newData.val() == true" }
          }
        },
        "teamDrawAt": {
          ".read": "auth != null",
          ".validate": "newData.isNumber()"
        },
        "teamsValidatedAt": {
          ".read": "auth != null",
          ".validate": "newData.isNumber()"
        },
        "sound": {
          ".read": "auth != null",
          ".validate": "newData.hasChildren(['music', 'effects', 'volume'])",
          "music": { ".validate": "newData.isBoolean()" },
          "effects": { ".validate": "newData.isBoolean()" },
          "volume": { ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 100" },
          "$other": { ".validate": false }
        },
        "bluffs": {
          "$index": {
            "$uid": {
              ".read": "auth != null && auth.uid == $uid",
              ".write": "auth != null && auth.uid == $uid && newData.exists() && root.child('sessions/' + $code + '/status').val() == 'question' && root.child('sessions/' + $code + '/settings/answerMode').val() == 'bluff' && root.child('sessions/' + $code + '/currentIndex').val() + '' == $index && root.child('sessions/' + $code + '/players/' + $uid + '/name').exists() && root.child('sessions/' + $code + '/bluffChecks/' + $index + '/' + $uid + '/verdict').val() != 'ok' && (!root.child('sessions/' + $code + '/bluffChecks/' + $index + '/' + $uid + '/refusals').exists() || root.child('sessions/' + $code + '/bluffChecks/' + $index + '/' + $uid + '/refusals').val() < 3) && newData.child('submittedAt').val() <= root.child('sessions/' + $code + '/phaseEndsAt').val() + 1000",
              ".validate": "newData.hasChildren(['text', 'submittedAt'])",
              "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
              "submittedAt": { ".validate": "newData.isNumber() && (newData.val() == now || newData.val() == data.val())" },
              "$other": { ".validate": false }
            }
          }
        },
        "bluffChecks": {
          "$index": {
            "$uid": {
              ".read": "auth != null && auth.uid == $uid",
              ".validate": "newData.hasChildren(['verdict', 'refusals', 'submittedAt'])",
              "verdict": { ".validate": "newData.isString() && newData.val().matches(/^(ok|truth|forbidden|empty)$/)" },
              "refusals": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
              "submittedAt": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          }
        },
        "bluffedBy": {
          ".read": "auth != null",
          "$index": {
            "$uid": { ".validate": "newData.val() == true" }
          }
        },
        "bluffChoices": {
          "$index": {
            "$choice": {
              ".validate": "$choice.matches(/^[0-9]{1,2}$/) && newData.hasChildren(['text', 'kind'])",
              "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
              "kind": { ".validate": "newData.isString() && newData.val().matches(/^(truth|bluff|decoy)$/)" },
              "authors": { "$i": { ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 128" } },
              "$other": { ".validate": false }
            }
          }
        },
        "bluffOwn": {
          "$index": {
            "$uid": {
              ".read": "auth != null && auth.uid == $uid",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 == 0"
            }
          }
        },
        "votes": {
          "$index": {
            "$uid": {
              ".write": "auth != null && auth.uid == $uid && !data.exists() && root.child('sessions/' + $code + '/status').val() == 'vote' && root.child('sessions/' + $code + '/currentIndex').val() + '' == $index && root.child('sessions/' + $code + '/players/' + $uid + '/name').exists() && newData.child('submittedAt').val() <= root.child('sessions/' + $code + '/phaseEndsAt').val() + 1000 && root.child('sessions/' + $code + '/currentQuestion/choices/' + newData.child('value').val()).exists() && newData.child('value').val() != root.child('sessions/' + $code + '/bluffOwn/' + $index + '/' + $uid).val()",
              ".validate": "newData.hasChildren(['value', 'submittedAt'])",
              "value": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 == 0" },
              "submittedAt": { ".validate": "newData.isNumber() && (newData.val() == now || newData.val() == data.val())" },
              "$other": { ".validate": false }
            }
          }
        },
        "votedBy": {
          ".read": "auth != null",
          "$index": {
            "$uid": {
              ".write": "auth != null && auth.uid == $uid && !data.exists() && root.child('sessions/' + $code + '/status').val() == 'vote' && root.child('sessions/' + $code + '/currentIndex').val() + '' == $index && newData.parent().parent().parent().child('votes/' + $index + '/' + $uid).exists()",
              ".validate": "newData.val() == true"
            }
          }
        },
        "bluffPoints": {
          "$index": {
            "$uid": { ".validate": "newData.isNumber() && newData.val() >= 0" }
          }
        },
        "answers": {
          "$index": {
            "$uid": {
              ".write": "auth != null && auth.uid == $uid && !data.exists() && root.child('sessions/' + $code + '/status').val() == 'question' && root.child('sessions/' + $code + '/currentIndex').val() + '' == $index && root.child('sessions/' + $code + '/players/' + $uid + '/name').exists() && newData.child('submittedAt').val() <= root.child('sessions/' + $code + '/phaseEndsAt').val() + 1000 && !newData.hasChild('correct') && !newData.hasChild('points') && !newData.hasChild('partial') && !newData.hasChild('fullPoints')",
              ".validate": "newData.hasChildren(['value', 'submittedAt'])",
              "value": { ".validate": "(newData.isString() && newData.val().length <= 60 && (newData.val().length >= 1 || newData.parent().child('artist').exists())) || newData.val() == 0 || newData.val() == 1 || newData.val() == 2 || newData.val() == 3" },
              "artist": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60 && newData.parent().child('value').isString()" },
              "submittedAt": { ".validate": "newData.isNumber() && (newData.val() == now || newData.val() == data.val())" },
              "correct": { ".validate": "newData.isBoolean()" },
              "points": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "partial": { ".validate": "newData.val() == true" },
              "fullPoints": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "$other": { ".validate": false }
            }
          }
        },
        "answeredBy": {
          ".read": "auth != null",
          "$index": {
            "$uid": {
              ".write": "auth != null && auth.uid == $uid && !data.exists() && root.child('sessions/' + $code + '/status').val() == 'question' && root.child('sessions/' + $code + '/currentIndex').val() + '' == $index && newData.parent().parent().parent().child('answers/' + $index + '/' + $uid).exists()",
              ".validate": "newData.val() == true"
            }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
