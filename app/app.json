{
  "expo": {
    "name": "Quiz'in",
    "slug": "quizin",
    "version": "1.2.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quizin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.herocorp.quizin",
      "supportsTablet": false,
      "icon": "./assets/images/icon-ios.png",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Quiz'in utilise ton réseau local pour trouver ton Chromecast et afficher le jeu sur la TV.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.herocorp.quizin",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#170646",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "name": "Quiz'in",
      "lang": "fr",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "BowlbyOne",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/bowlby-one/400Regular/BowlbyOne_400Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Nunito-Bold",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/nunito/700Bold/Nunito_700Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Nunito-ExtraBold",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/nunito/800ExtraBold/Nunito_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              },
              {
                "fontFamily": "Nunito-Black",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/nunito/900Black/Nunito_900Black.ttf",
                    "weight": 900
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./node_modules/@expo-google-fonts/bowlby-one/400Regular/BowlbyOne_400Regular.ttf",
              "./node_modules/@expo-google-fonts/nunito/700Bold/Nunito_700Bold.ttf",
              "./node_modules/@expo-google-fonts/nunito/800ExtraBold/Nunito_800ExtraBold.ttf",
              "./node_modules/@expo-google-fonts/nunito/900Black/Nunito_900Black.ttf"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#170646",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "react-native-google-cast",
        {
          "receiverAppId": "AA4E97E3",
          "expandedController": false,
          "androidPlayServicesCastFrameworkVersion": "22.3.1"
        }
      ],
      "./plugins/withMediaRouterVersion"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c48bad97-8d85-478e-b33e-48f414437a77"
      }
    },
    "owner": "heromomies"
  }
}
